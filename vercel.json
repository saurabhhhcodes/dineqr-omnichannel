{
  "version": 2,
  "rewrites": [
    {
      "source": "/api/(.*)",
      "destination": "/api/index.js"
    },
    {
      "source": "/videos/(.*)",
      "destination": "/videos/$1"
    },
    {
      "source": "/(.*)",
      "destination": "/index.html"
    },
    {
      "source": "/(.*)",
      "destination": {
        "type": "service",
        "service": "dineqr-platform"
      }
    }
  ],
  "services": {
    "dineqr-platform": {
      "root": ".",
      "framework": "vite",
      "buildCommand": "npm install && npm run build"
    }
  }
}
