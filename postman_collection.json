{
  "info": {
    "_postman_id": "dineqr-platform-e2e-suite",
    "name": "DineQR Enterprise Platform API & Razorpay Standard Suite",
    "description": "Comprehensive Postman test collection for DineQR multi-tenant restaurant POS, Razorpay standard checkout, staff limits & timeclock, seating, menu customization, and local SQLite data folders.",
    "schema": "https://schema.getpostman.com/json/collection/v2.1.0/collection.json"
  },
  "variable": [
    {
      "key": "baseUrl",
      "value": "http://localhost:3005",
      "type": "string"
    },
    {
      "key": "testOrderId",
      "value": "",
      "type": "string"
    },
    {
      "key": "testRzpOrderId",
      "value": "",
      "type": "string"
    },
    {
      "key": "testMenuItemId",
      "value": "item_1",
      "type": "string"
    }
  ],
  "item": [
    {
      "name": "1. Health & Server Status",
      "request": {
        "method": "GET",
        "header": [],
        "url": {
          "raw": "{{baseUrl}}/api/health",
          "host": ["{{baseUrl}}"],
          "path": ["api", "health"]
        }
      }
    },
    {
      "name": "2. Razorpay - Create Order (Standard Checkout)",
      "request": {
        "method": "POST",
        "header": [{ "key": "Content-Type", "value": "application/json" }],
        "body": {
          "mode": "raw",
          "raw": "{\n  \"amount\": 50000,\n  \"currency\": \"INR\",\n  \"receipt\": \"rcpt_postman_01\"\n}"
        },
        "url": {
          "raw": "{{baseUrl}}/api/create-order",
          "host": ["{{baseUrl}}"],
          "path": ["api", "create-order"]
        }
      }
    },
    {
      "name": "3. Razorpay - Create Order (Validation: Amount < 100 paise)",
      "request": {
        "method": "POST",
        "header": [{ "key": "Content-Type", "value": "application/json" }],
        "body": {
          "mode": "raw",
          "raw": "{\n  \"amount\": 50,\n  \"currency\": \"INR\"\n}"
        },
        "url": {
          "raw": "{{baseUrl}}/api/create-order",
          "host": ["{{baseUrl}}"],
          "path": ["api", "create-order"]
        }
      }
    },
    {
      "name": "4. Razorpay - Verify Payment (Signature Mismatch Failure)",
      "request": {
        "method": "POST",
        "header": [{ "key": "Content-Type", "value": "application/json" }],
        "body": {
          "mode": "raw",
          "raw": "{\n  \"razorpay_order_id\": \"order_TxIEOzZMVeoNrl\",\n  \"razorpay_payment_id\": \"pay_mock_123\",\n  \"razorpay_signature\": \"invalid_signature_hex\"\n}"
        },
        "url": {
          "raw": "{{baseUrl}}/api/verify-payment",
          "host": ["{{baseUrl}}"],
          "path": ["api", "verify-payment"]
        }
      }
    },
    {
      "name": "5. Restaurants - List All Active Tenancies",
      "request": {
        "method": "GET",
        "header": [],
        "url": {
          "raw": "{{baseUrl}}/api/restaurants",
          "host": ["{{baseUrl}}"],
          "path": ["api", "restaurants"]
        }
      }
    },
    {
