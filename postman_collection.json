      "request": {
        "method": "POST",
        "header": [{ "key": "Content-Type", "value": "application/json" }],
        "body": {
          "mode": "raw",
          "raw": "{\n  \"name\": \"Chai & Sourdough Artisan Bakery\",\n  \"owner_name\": \"Vikramaditya Roy\",\n  \"business_type\": \"cafe\",\n  \"station_type\": \"table\",\n  \"station_count\": 8,\n  \"subscription_plan\": \"Enterprise Scale & Staff Hub (₹5,000/mo)\",\n  \"admin_pin\": \"1234\",\n  \"staff_pin\": \"1234\"\n}"
        },
        "url": {
          "raw": "{{baseUrl}}/api/restaurants/onboard",
          "host": ["{{baseUrl}}"],
          "path": ["api", "restaurants", "onboard"]
        }
      }
    },
    {
      "name": "7. Menu - Fetch Items & Categories",
      "request": {
        "method": "GET",
        "header": [],
        "url": {
          "raw": "{{baseUrl}}/api/menu?restaurant_id=rest_losteria",
          "host": ["{{baseUrl}}"],
          "path": ["api", "menu"],
          "query": [{ "key": "restaurant_id", "value": "rest_losteria" }]
        }
      }
    },
    {
      "name": "8. Menu - Instant Price Change",
      "request": {
        "method": "PATCH",
        "header": [{ "key": "Content-Type", "value": "application/json" }],
        "body": {
          "mode": "raw",
          "raw": "{\n  \"price\": 380\n}"
