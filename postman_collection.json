          "raw": "{\n  \"restaurant_id\": \"rest_losteria\",\n  \"category_id\": \"cat_pizzas\",\n  \"name\": \"Calabrian Spicy Burrata Pizza\",\n  \"description\": \"Crushed San Marzano tomatoes, artisanal creamy burrata, and spicy Calabrian chili paste on 48h sourdough.\",\n  \"price\": 690,\n  \"image_url\": \"https://images.unsplash.com/photo-1513104890138-7c749659a591?w=800&q=80\",\n  \"video_url\": \"/videos/item_1.mp4\",\n  \"is_veg\": 1,\n  \"spice_level\": \"Hot\"\n}"
