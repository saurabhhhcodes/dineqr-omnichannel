# DineQR Environment Variables Template
PORT=3001
VITE_API_URL=http://localhost:3001

# Razorpay Configuration (Use your Razorpay Test/Live keys)
RAZORPAY_KEY_ID=rzp_test_your_key_id
RAZORPAY_KEY_SECRET=your_razorpay_secret
VITE_RAZORPAY_KEY_ID=rzp_test_your_key_id

# MongoDB Atlas Cloud Cluster (Free M0 Instance for Multi-Tenant Isolation)
MONGODB_URI=mongodb+srv://<username>:<password>@cluster0.mongodb.net/dineqr_cloud?retryWrites=true&w=majority
MONGODB_DB_NAME=dineqr_cloud

# Restaurant Details
RESTAURANT_NAME="L'Osteria Gourmet Bistro"
RESTAURANT_TAGLINE="Artisanal Kitchen & Wood-Fired Oven"
RESTAURANT_PHONE="+91 98765 43210"
RESTAURANT_ADDRESS="Plot 42, Galleria Boulevard, Indiranagar, Bengaluru - 560038"
RESTAURANT_GSTIN="29ABCDE1234F1Z5"
RESTAURANT_FSSAI="11223344556677"
CURRENCY="INR"
CGST_PERCENT=2.5
SGST_PERCENT=2.5
SERVICE_CHARGE_PERCENT=0
